# Frontend routing only. No API keys, database credentials or model tokens belong here.
# Browser requests use /api by default, forwarded by Vite during local development.
VITE_API_BASE_URL=/api
# Set to the teammate's API ORIGIN once it is reachable; do not append /api.
BACKEND_URL=http://127.0.0.1:8000
# Alternative: use VITE_API_BASE_URL=https://reachable-backend.example/api directly.
# A direct browser connection requires the backend to allow the frontend origin via CORS.
# Model/database/translation credentials must remain on the backend PC.

# Firebase Web app values: copy from Firebase Console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=replace-with-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=jan-setu-3b317.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=jan-setu-3b317
VITE_FIREBASE_APP_ID=replace-with-web-app-id
# Optional: VITE_FIREBASE_STORAGE_BUCKET and VITE_FIREBASE_MESSAGING_SENDER_ID

# Presentation phone OTP is the default. Set firebase to use the preserved Firebase integration.
VITE_AUTH_MODE=presentation
