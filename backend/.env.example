# Copy to backend/.env. No model or account credentials belong in VITE_* variables.
QWEN_PROVIDER=ollama
QWEN_ENDPOINT=http://127.0.0.1:11434
QWEN_MODEL=qwen3:8b
QWEN_API_KEY=
AI_TIMEOUT=180

# Required for non-English processing and beneficiary output translation.
# POST JSON contract is documented in README.md.
INDICTRANS_ENDPOINT=
INDICTRANS_API_KEY=
INDICTRANS_INDIC_EN_MODEL=ai4bharat/indictrans2-indic-en-1B
INDICTRANS_EN_INDIC_MODEL=ai4bharat/indictrans2-en-indic-1B

# Token -> server-owned identity/role/assessor assignment.
# Leave empty until accounts are provisioned using backend/provision_account.py.
SCREENING_ACCOUNTS={}
MAX_QUESTIONS=8
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:3001
# Default: backend/screening.sqlite3
# DATABASE_PATH=C:/absolute/path/screening.sqlite3

# Optional OCR gateway: multipart file -> {"text":"actual OCR text"}
OCR_ENDPOINT=
OCR_API_KEY=

# Optional faster-whisper model (pip install faster-whisper separately)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Optional SCREENING_RUBRIC JSON overrides the documented 8-domain mapping.
# Values: [weight, ["module.field", ...]]; weights must sum to 1.

# Local presentation login only: OTP is displayed on screen, never sent by SMS.
# All presentation roles/accounts/records use a SEPARATE database.
PRESENTATION_PHONE_LOGIN=true
# DEMO_DATABASE_PATH=C:/absolute/path/presentation.sqlite3
